Algoritmo "cadidato"
// Autor(a): Rafael Carvalhp Senger
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  nota: inteiro

Inicio
  // Seção de Comandos
  escreval("Insira a nota do candidato:")
  leia(nota)

  se nota >= 70 entao
    escreval("Aprovado.")
  senao
    escreval("Reprovado.")
  fimse

fimalgoritmo
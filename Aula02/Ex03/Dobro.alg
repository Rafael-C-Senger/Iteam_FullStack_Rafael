Algoritmo "DobroOuTriplo"
// Autor(a): Rafael Carvalho Senger
// Data: 03/08/2026

Var
   // Seção de Declarações das variáveis
   numero : inteiro
   dobro : inteiro
Inicio
   // Seção de Comandos
   escreval("Insira um número inteiro:")
   leia(numero)
   dobro <- numero * 2
   escreval("O dobro de ",numero, " é: ", dobro)

fimalgoritmo
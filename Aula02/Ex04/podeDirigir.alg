Algoritmo "podeDirigir"
// Autor(a): Rafael Carvalho Senger
// Data: 03/08/2026

Var
   // Seção de Declarações das variáveis
   idade : inteiro
Inicio
   // Seção de Comandos
   escreval("Insira a sua idade:")
   leia(idade)

   se idade > 17 entao
      escreval("Pode dirigir tranquilamente.")
   senao
      escreval("Nao dirija!")
   fimse

fimalgoritmo
Algoritmo "tempConversao"
// Autor(a): Rafael Carvalho Senger
// Data: 03/08/2026

Var
   // Seção de Declarações das variáveis
   farenhait, celsius : real


Inicio
   // Seção de Comandos
   escreval("Insira a temperatura em celsius:")
   leia(celsius)

   farenhait <- (celsius* 9 / 5) + 32
   escreval("A temperaura em Farenhait e:", farenhait)

fimalgoritmo
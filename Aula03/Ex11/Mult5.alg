Algoritmo "Mult5"
// Autor(a): Rafael Carvalho Senger
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  contador, numero : inteiro

Inicio
  // Seção de Comandos
  contador <- 1

  escreval("Digite um numero:")
  leia (numero)

  para contador de 1 ate numero faca

    se (contador % 5) = 0 entao

      escreval(":", contador)

    fimse

  fimpara


fimalgoritmo
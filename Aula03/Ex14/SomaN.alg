Algoritmo "SomaN"
// Autor(a): Rafael Carvalho Senger
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  contador, soma, numero : inteiro

Inicio
  // Seção de Comandos
  soma <- 0
  escreval("Digite um numero:")
  leia(numero)
  
  para contador de 1 ate numero faca 
     	soma <- contador + soma
  fimpara
  
  escreval("A soma de 1 ate ",numero," e: ",soma)
	

fimalgoritmo
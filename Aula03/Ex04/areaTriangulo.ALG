Algoritmo "areaTriangulo"
// Autor(a): Rafael Carvalho Senger
// Data: 03/08/2026

Var
   // Seção de Declarações das variáveis
   area, base, altura : real
Inicio
   // Seção de Comandos
   escreval("Insira a base do triangulo:")
   leia(base)
   
   escreval("Insira a altura do triangulo:")
   leia(altura)

   area <- (base*altura)/2
   
   escreval("A area do triangulo e: ",area)

fimalgoritmo
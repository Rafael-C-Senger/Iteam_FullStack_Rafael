Algoritmo "ParAte100"
// Autor(a): Rafael Carvalho Senger
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  contador : inteiro

Inicio
  // Seção de Comandos
  para contador de 1 ate 100 faca 
      se (contador % 2) = 0 entao
      	escreval(contador)
     fimse
  fimpara
	

fimalgoritmo
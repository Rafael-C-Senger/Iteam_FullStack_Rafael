Algoritmo "Contagem regressiva"
// Autor(a): Rafael Carvalho Senger
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  contador : inteiro

Inicio
  // Seção de Comandos
  para contador de 10 ate 1 passo -1 faca 
      escreval(contador)
  fimpara
	
  escreval("Feliz Ano novo!")

fimalgoritmo